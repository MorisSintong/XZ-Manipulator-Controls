[
  {
    "label": "Build (Debug)",
    "command": "cmake",
    "args": ["--build", "--preset", "Debug"],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["build"]
  },
  {
    "label": "Build (Release)",
    "command": "cmake",
    "args": ["--build", "--preset", "Release"],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["build"]
  },
  {
    "label": "Rebuild (Debug)",
    "command": "cmake",
    "args": ["--build", "--preset", "Debug", "--clean-first"],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["build"]
  },
  {
    "label": "CMake: Configure (Debug)",
    "command": "cmake",
    "args": ["--preset", "Debug"],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["cmake"]
  },
  {
    "label": "CMake: Configure (Release)",
    "command": "cmake",
    "args": ["--preset", "Release"],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["cmake"]
  },
  {
    "label": "Host tests: StallGuard CLI",
    "command": "cmake -S Apps/stallguard_cli/tests -B Apps/stallguard_cli/tests/build-host -G Ninja -DCMAKE_C_COMPILER=clang && cmake --build Apps/stallguard_cli/tests/build-host && ctest --test-dir Apps/stallguard_cli/tests/build-host --output-on-failure",
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["test"]
  },
  {
    "label": "Host tests: Motion Diagnostics",
    "command": "powershell -ExecutionPolicy Bypass -File Apps/motion_diagnostics/Tests/run_tests.ps1",
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["test"]
  },
  {
    "label": "Clean",
    "command": "cmake",
    "args": ["--build", "--preset", "Debug", "--target", "clean"],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["clean"]
  },
  {
    "label": "Flash (J-Link) — Default Profile",
    "command": "C:/tools/jlink/JLink.exe",
    "args": [
      "-device",
      "STM32H723ZE",
      "-if",
      "SWD",
      "-speed",
      "4000",
      "-autoconnect",
      "1",
      "-CommanderScript",
      "flash.jlink"
    ],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["flash"]
  },
  {
    "label": "Flash: Motion Diagnostics (J-Link)",
    "command": "C:/tools/jlink/JLink.exe",
    "args": [
      "-device",
      "STM32H723ZE",
      "-if",
      "SWD",
      "-speed",
      "4000",
      "-autoconnect",
      "1",
      "-CommanderScript",
      "flash_diagnostics.jlink"
    ],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["flash"]
  },
  {
    "label": "Flash: StallGuard CLI (J-Link)",
    "command": "C:/tools/jlink/JLink.exe",
    "args": [
      "-device",
      "STM32H723ZE",
      "-if",
      "SWD",
      "-speed",
      "4000",
      "-autoconnect",
      "1",
      "-CommanderScript",
      "flash_stallguard_cli.jlink"
    ],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["flash"]
  },
  {
    "label": "Flash: Z-Bounce Emulation (J-Link)",
    "command": "C:/tools/jlink/JLink.exe",
    "args": [
      "-device",
      "STM32H723ZE",
      "-if",
      "SWD",
      "-speed",
      "4000",
      "-autoconnect",
      "1",
      "-CommanderScript",
      "flash_zbounce.jlink"
    ],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["flash"]
  },
  {
    "label": "Reset MCU (J-Link)",
    "command": "C:/tools/jlink/JLink.exe",
    "args": [
      "-device",
      "STM32H723ZE",
      "-if",
      "SWD",
      "-speed",
      "4000",
      "-autoconnect",
      "1",
      "-CommanderScript",
      "reset.jlink"
    ],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["reset"]
  },
  {
    "label": "Start J-Link GDB Server",
    "command": "C:/tools/jlink/JLinkGDBServerCL.exe",
    "args": [
      "-select",
      "USB",
      "-device",
      "STM32H723ZE",
      "-endian",
      "little",
      "-if",
      "SWD",
      "-speed",
      "4000"
    ],
    "cwd": "${ZED_WORKTREE_ROOT}/MotorControls/MotionFirmware",
    "tags": ["debug"]
  }
]
