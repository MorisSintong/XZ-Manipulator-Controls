# ==============================================================================
# .gitignore - XZ Manipulator Controls
# Multi-subsystem repository:
#   - Embedded C/C++ & STM32 Firmware (CMake, STM32CubeIDE, J-Link)
#   - Vision System (Python, YOLO / Ultralytics, OpenCV, ESP32)
#   - PLC Ladder Logic (Omron CX-Programmer)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Embedded C/C++ & STM32 Build Outputs
# ------------------------------------------------------------------------------
# Build directories
build/
build*/
cmake-build-*/
.build/
__cmake_systeminformation/
_deps/
bin/
out/

# CMake cache, presets, and temporary files
CMakeUserPresets.json
compile_commands.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeScripts/
Testing/
Makefile
*.ninja
*.ninja_log
*.ninja_deps
CPackConfig.cmake
CPackSourceConfig.cmake

# Compiler intermediate & object files
*.o
*.obj
*.d
*.su

# Static & dynamic libraries
*.a
*.lib
*.so
*.dll
*.dylib

# Linker map & listing files
*.map
*.list
*.lst

# Binary images (firmware builds)
*.elf
*.hex
*.bin
*.axf
*.srec

# Preserve audited diagnostic release binaries
!MotorControls/Drivers/TMC2240-Driver/firmware/*.bin
!MotorControls/Drivers/TMC2240-Driver/firmware/*.hex
!MotorControls/Drivers/TMC2240-Driver/firmware/*.elf

# Test coverage & profiling
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# Static analysis & diagnostics
*.dump
*.ctu-info
cppcheck-build-dir/
cppcheck-result.xml

# Clang / Language Server caches
.cache/

# J-Link & Debugger logs
JLink.log
JLinkExe.log
JLinkGDBServer*.log
openocd.log
gdb.txt
.gdb_history

# ------------------------------------------------------------------------------
# 2. STM32CubeIDE & Eclipse
# ------------------------------------------------------------------------------
.metadata/
Debug/
Release/
*.launch
.settings/

