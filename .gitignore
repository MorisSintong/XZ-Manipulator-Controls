*.py[cod]
*$py.class
*.cache

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & distribution
dist/
*.egg-info/
.eggs/

# Testing & linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Jupyter Notebooks
.ipynb_checkpoints/

